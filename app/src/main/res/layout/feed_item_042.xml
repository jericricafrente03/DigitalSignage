<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    tools:background="#220b59"
    android:orientation="vertical">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tv_schedule"
            android:layout_width="100dp"
            android:layout_height="80dp"
            android:background="@drawable/rounded_corners8"
            android:fontFamily="@font/bold_itc"
            android:gravity="center"
            android:textColor="#160436"
            app:autoSizeMaxTextSize="55sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform"
            android:maxLines="2"
            app:layout_constraintBottom_toBottomOf="@id/view"
            app:layout_constraintEnd_toEndOf="@id/gl_ver_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="JULY 04" />

        <LinearLayout
            android:id="@+id/view"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:weightSum="2"
            android:padding="5dp"
            android:layout_marginStart="10dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_schedule"
            app:layout_constraintTop_toTopOf="parent">

            <com.jeric.bitteldigitalsignage.ui.components.ScrollingTextview
                android:id="@+id/tv_company"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/itc"
                android:format12Hour="EEEE, MMM. dd"
                android:gravity="start|center"
                android:textColor="@color/white"
                app:autoSizeMaxTextSize="45sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="6sp"
                app:autoSizeTextType="uniform"
                android:maxLines="1"
                tools:text="FIREWORKS SHOW" />

            <com.jeric.bitteldigitalsignage.ui.components.ScrollingTextview
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center|start"
                android:layout_weight="1"
                android:fontFamily="@font/small_itc"
                android:textColor="@color/white"
                app:autoSizeMaxTextSize="45sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="6sp"
                app:autoSizeTextType="uniform"
                android:maxLines="1"
                tools:text="That does show me the package info but" />


            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_ver_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.5" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_ver_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.5" />
        </LinearLayout>


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_ver_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.30" />
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>