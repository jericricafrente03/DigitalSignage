<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    
    
    
    <TextView
        android:id="@+id/tv_country"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="left"
        android:text="PHILIPPINES"
        android:fontFamily="@font/itc"
        android:textColor="#000"
        android:textStyle="bold"
        android:textSize="24sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextClock
        android:id="@+id/tc_time"
        android:textColor="#000"
        android:text="11:30 AM"
        android:fontFamily="@font/itc"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@+id/tv_country"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <TextView
        android:id="@+id/tv_date"
        android:textColor="#000"
        app:layout_constraintTop_toBottomOf="@+id/tc_time"
        app:layout_constraintLeft_toLeftOf="parent"
        android:text="August 24, 2020"
        android:textSize="12sp"
        android:fontFamily="@font/itc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <TextView
        android:id="@+id/tv_day_of_week"
        android:textColor="#000"
        app:layout_constraintTop_toBottomOf="@+id/tv_date"
        app:layout_constraintLeft_toLeftOf="parent"
        android:text="Monday"
        android:fontFamily="@font/itc"
        android:textSize="12sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />


    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/w01d"
        app:layout_constraintStart_toEndOf="@+id/tv_country"
        app:layout_constraintTop_toBottomOf="@+id/tv_country" />



    <TextView
        android:id="@+id/tv_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="35°C"
        android:fontFamily="@font/itc"
        android:textColor="#000"
        android:textSize="24sp"
        android:layout_marginLeft="4dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon"
        app:layout_constraintLeft_toLeftOf="parent"
        />

    <com.jeric.bitteldigitalsignage.ui.components.ScrollingTextview
        android:id="@+id/tv_description"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="@id/iv_icon"
        app:layout_constraintEnd_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon"
        app:layout_constraintBottom_toBottomOf="@+id/tv_temp"
        android:textColor="#000"
        android:maxLength="20"
        android:fontFamily="@font/itc"
        android:layout_marginLeft="4dp"
        android:text="Light Intensity Shower Rain"
        android:textSize="12sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>


</androidx.constraintlayout.widget.ConstraintLayout>