<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#dddddd"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_ver_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.03" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_ver_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_ver_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.10" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_ver_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardBackgroundColor="#dddddd"
        android:id="@+id/view"
        app:layout_constraintBottom_toTopOf="@id/gl_ver_5"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title"
            tools:text="TODAY'S EVENTS"
            android:textColor="@color/gray"
            android:fontFamily="@font/itc"
            android:textSize="35sp"
            android:gravity="start|center"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>


    </androidx.cardview.widget.CardView>

    <ImageView
        android:layout_width="40dp"
        android:id="@+id/icon"
        android:layout_marginTop="20dp"
        android:layout_height="40dp"
        android:src="@drawable/calendar"
        app:layout_constraintStart_toStartOf="@id/gl_ver_1"
        app:layout_constraintTop_toBottomOf="@id/view"
        android:contentDescription="@string/desc" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/itc"
        android:id="@+id/clock1"
        android:format12Hour="EEEE, MMM. dd"
        app:layout_constraintBottom_toBottomOf="@id/icon"
        android:layout_marginStart="10dp"
        android:textColor="@color/gray"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintTop_toTopOf="@id/icon"
        android:textSize="25sp"
        tools:text="Thursday, Nov. 5" />

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="0dp"
        android:id="@+id/rv_feed58"
        tools:listitem="@layout/feed_item_058"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/icon"
        app:layout_constraintStart_toStartOf="@id/gl_ver_1"
        app:layout_constraintEnd_toEndOf="@id/gl_ver_4"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="20dp"
        android:layout_height="0dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>